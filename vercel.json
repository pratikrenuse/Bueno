{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/linkedin-remind",
      "schedule": "0 7 * * 1,3"
    },
    {
      "path": "/api/linkedin-dispatch",
      "schedule": "0 6 * * 2,4"
    }
  ],
  "rewrites": [
    {
      "source": "/api/linkedin/:action",
      "destination": "/api/linkedin?action=:action"
    },
    {
      "source": "/api/linkedin-:action",
      "destination": "/api/linkedin?action=:action"
    },
    {
      "source": "/api/fb/:action",
      "destination": "/api/fb?action=:action"
    },
    {
      "source": "/api/fb-:action",
      "destination": "/api/fb?action=:action"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
