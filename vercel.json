{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "crons": [
    { "path": "/api/linkedin-dispatch", "schedule": "0 6 * * 2,4" },
    { "path": "/api/linkedin-remind", "schedule": "0 17 * * 0,2" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ]
}
