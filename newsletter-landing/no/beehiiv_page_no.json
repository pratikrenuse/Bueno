:28px;border-radius:20px;background:#0b0c18;z-index:3}\n.bnp .status{position:absolute;top:0;left:0;right:0;height:52px;padding:16px 26px 0;display:flex;justify-content:space-between;font-size:13px;font-weight:600;background:#fff;z-index:2}\n.bnp .bar{position:absolute;top:52px;left:0;right:0;height:44px;padding:0 18px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:#fff;z-index:2;font-size:14px;color:var(--accent)}\n.bnp .from{position:absolute;top:96px;left:0;right:0;padding:10px 18px;display:flex;gap:10px;align-items:center;border-bottom:1px solid var(--line);background:#fff;z-index:2}\n.bnp .av{width:32px;height:32px;border-radius:9px;background:var(--navy);color:#fff;font-family:var(--serif);font-size:19px;display:flex;align-items:center;justify-content:center;flex:none}\n.bnp .from b{display:block;font-size:13px}.bnp .from small{font-size:11px;color:var(--mute)}\n.bnp .scroll{position:absolute;top:150px;bottom:0;left:0;right:0;overflow:hidden}\n.bnp .feed{animation:bnpscroll 34s linear infinite}\n.bnp .stage:hover .feed{animation-play-state:paused}\n@keyframes bnpscroll{0%,6%{transform:translateY(0)}94%,100%{transform:translateY(calc(-100% + 480px))}}\n.bnp .mail{padding:18px 18px 40px}\n.bnp .mhead{border-bottom:3px solid var(--navy);padding-bottom:12px;margin-bottom:14px}\n.bnp .mhead img{width:150px}\n.bnp .kick{font-family:var(--serif);font-size:21px;line-height:1.2}\n.bnp .date{font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);margin:6px 0 12px}\n.bnp .hi{font-size:12.5px;line-height:1.6;color:var(--mute);margin-bottom:14px}\n.bnp .story,.bnp .guide{padding:12px 0;border-top:1px solid var(--line)}\n.bnp .guide{background:var(--light);border:0;border-radius:12px;padding:14px;margin:6px 0}\n.bnp .tag{font-family:var(--mono);font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:5px}\n.bnp h4{font-family:var(--serif);font-weight:500;font-size:15.5px;line-height:1.3;margin-bottom:5px}\n.bnp .story p:not(.tag),.bnp .guide p:not(.tag){font-size:12px;line-height:1.6;color:var(--mute)}\n.bnp .btn{display:inline-block;margin-top:10px;background:var(--navy);color:#fff;font-size:11.5px;font-weight:600;padding:7px 12px;border-radius:8px}\n.bnp .sign{font-size:12px;color:var(--mute);margin-top:14px;border-top:1px solid var(--line);padding-top:12px}\n.bnp .sign b{color:var(--navy)}\n.bnp .badge{position:absolute;z-index:4;right:-18px;bottom:110px;background:var(--navy);color:#fff;border-radius:6px;padding:14px 18px;display:flex;align-items:center;gap:12px;transform:rotate(3deg);box-shadow:0 18px 40px -16px rgba(1,2,33,.5)}\n.bnp .badge .n{font-family:var(--serif);font-size:44px;line-height:1;color:var(--gold)}\n.bnp .badge .t{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;line-height:1.5;max-width:150px}\n.bnp .cap{position:relative;z-index:1;display:flex;justify-content:space-between;font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);margin-top:26px}\n@media(max-width:760px){.bnp .phone{height:600px;transform:none}.bnp .badge{right:4px;bottom:90px}.bnp .cap{justify-content:center}.bnp .cap span:last-child{display:none}}\n@media(prefers-reduced-motion:reduce){.bnp .feed{animation:none}}\n</style>\n<div class=\"bnp\"><div class=\"stage\">\n  <div class=\"halo\"></div>\n  <div class=\"phone\"><div class=\"screen\">\n    <div class=\"island\"></div>\n    <div class=\"status\"><span>9:41</span><span>&#9679;&#9679;&#9679;</span></div>\n    <div class=\"bar\"><span>&#8249; Innboks</span><span>&#8943;</span></div>\n    <div class=\"from\"><div class=\"av\">B</div><div><b>Bueno Nyhetsbrev</b><small>Til: deg, mandag 08:00</small></div></div>\n    <div class=\"scroll\"><div class=\"feed\">\n<div class=\"mail\">\n  <div class=\"mhead\"><img src=\"https://www.247spain.es/images/pro/bueno-logo-navy.png\" alt=\"Bueno, Property Finance Simplified\"></div>\n  <p class=\"kick\">Disse to ukene i det spanske eiendomsmarkedet</p>\n  <p class=\"date\">Bueno Nyhetsbrev</p>\n  <p class=\"hi\">Det har v&aelig;rt to begivenhetsrike uker. Prisene har n&aring;dd ny rekord, og H&oslash;yesterett har avgjort en sak om et gebyr i et sameie som mange eiere vil kjenne igjen.</p>\n  <div class=\"story\"><p class=\"tag\">Nyheter</p><h4>Bruktboliger har aldri v&aelig;rt dyrere.</h4><p>Bruktboliger kostet i snitt 2 955 euro per kvadratmeter i oktober, det h&oslash;yeste idealista noen gang har m&aring;lt.</p></div>\n  <div class=\"story\"><p class=\"tag\">Nyheter</p><h4>H&oslash;yesterett stopper et gebyr p&aring; 50 cent per dag.</h4><p>Sameier kan fortsatt kreve inn ubetalte utgifter, men gebyrene m&aring; v&aelig;re rimelige.</p></div>\n  <div class=\"guide\"><p class=\"tag\">Gratis guide</p><h4>Fellesutgifter i Spania: hva du betaler og dine rettigheter.</h4><p>Hva fellesutgiftene dekker, hvordan &aring;rsm&oslash;tet fungerer og hvordan du klager p&aring; et vedtak.</p><span class=\"btn\">Les guiden</span></div>\n  <div class=\"story\"><p class=\"tag\">Regionen i s&oslash;kelyset</p><h4>Marbella og den vestlige Costa del Sol.</h4><p>OECD peker p&aring; omr&aring;det rundt M&aacute;laga og Marbella som det vanskeligste stedet i Spania &aring; kj&oslash;pe bolig.</p></div>\n  <div class=\"story\"><p class=\"tag\">Leserens sp&oslash;rsm&aring;l</p><h4>&laquo;Sameiet v&aring;rt vil ilegge gebyr til eiere som betaler for sent. Har de lov til det?&raquo;</h4><p>Ja, men gebyret m&aring; st&aring; i forhold til det som er skyldig.</p></div>\n  <p class=\"sign\">Vi snakkes i neste utgave,<br><b>Maria, teamet i Bueno</b></p>\n</div></div></div>\n  </div></div>\n  <div class=\"badge\"><span class=\"n\">2</span><span class=\"t\">Du leser det p&aring; to minutter, annenhver mandag.</span></div>\n  <div class=\"cap\"><span>Et blikk i innboksen</span><span>Pek for &aring; pause</span></div>\